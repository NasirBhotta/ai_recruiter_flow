# ==============================================================================
# RecruitFlow Configuration
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# System Mode
# true: Runs locally without any Google credentials, API keys, or live APIs.
# false: Connects to live Gmail, Google Sheets, and Gemini API.
# ------------------------------------------------------------------------------
DEMO_MODE=true

# ------------------------------------------------------------------------------
# Gemini API Configuration
# Get key from Google AI Studio: https://aistudio.google.com/
# Recommended models: gemini-2.5-flash, gemini-3.7-flash
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Google Workspace / OAuth Desktop Flow (Gmail & Sheets)
# Download OAuth 2.0 Client ID (Desktop Application) credentials.json from GCP.
# token.json is generated automatically during the first browser authentication.
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_SECRETS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# ------------------------------------------------------------------------------
# Google Sheets Candidate Tracker
# SPREADSHEET_ID is the long ID string in your Google Sheets URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
# ------------------------------------------------------------------------------
SPREADSHEET_ID=
SHEET_NAME=Candidates

# ------------------------------------------------------------------------------
# Gmail Intake Poller
# Searches for candidate application emails with PDF attachments.
# ------------------------------------------------------------------------------
GMAIL_QUERY=subject:"RecruitFlow Demo" has:attachment newer_than:7d
MAX_ATTACHMENT_SIZE_MB=10.0
POLL_INTERVAL_SECONDS=60

# ------------------------------------------------------------------------------
# Email Sending Safety Controls
# ENABLE_EMAIL_SEND: Must be explicitly 'true' to allow real Gmail API email dispatch.
# DEMO_RECIPIENT_OVERRIDE: When set, reroutes all outgoing candidate emails to your
# own inbox (e.g. your personal email) for end-to-end testing without emailing real people.
# SCHEDULING_URL: Fixed booking calendar link inserted into approved invitation emails.
# ------------------------------------------------------------------------------
ENABLE_EMAIL_SEND=false
DEMO_RECIPIENT_OVERRIDE=
SCHEDULING_URL=https://calendly.com/recruitflow-demo/interview-30min
SENDER_NAME=RecruitFlow Talent Team

# ------------------------------------------------------------------------------
# Storage Paths
# ------------------------------------------------------------------------------
DATABASE_PATH=data/recruitflow.db
SAMPLE_CVS_DIR=data/sample_cvs
